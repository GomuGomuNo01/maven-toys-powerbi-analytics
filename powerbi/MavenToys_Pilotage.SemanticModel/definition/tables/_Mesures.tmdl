	measure 'Vue par défaut' =
			SELECTEDVALUE ( Calendrier[Année] ) = 2023
			    && NOT ISFILTERED ( Produits[Catégorie] )
			    && NOT ISFILTERED ( Magasins[Type d'emplacement] )
		displayFolder: 3. Libellés et couleurs
		lineageTag: e17e8011-fe10-4d71-907d-ac2f3a58ad65

	measure 'Vue par défaut stock' =
			NOT ISFILTERED ( Produits[Catégorie] )
			    && NOT ISFILTERED ( Magasins[Type d'emplacement] )
			    && NOT ISFILTERED ( Stock[Statut stock] )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 9ac89b61-347f-4481-a44d-b495b9d5d222

	measure 'Titre CA mensuel' = IF ( [Vue par défaut], "Le CA dépasse l'année précédente chaque mois", "CA mensuel : N vs N-1" )
		displayFolder: 3. Libellés et couleurs
