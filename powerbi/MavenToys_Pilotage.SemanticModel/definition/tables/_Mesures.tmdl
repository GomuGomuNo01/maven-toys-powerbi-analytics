table _Mesures
	lineageTag: eaa18b3a-57e7-43ec-a2fa-e48a555654cf

	measure CA = SUMX ( Ventes, Ventes[Unités] * RELATED ( Produits[Prix unitaire] ) )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 1. Ventes et rentabilité
		lineageTag: b07f06f8-5264-4258-a739-dd529dbc222b

	measure 'Coût des ventes' = SUMX ( Ventes, Ventes[Unités] * RELATED ( Produits[Coût unitaire] ) )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 43bd5e20-ab5b-42b9-b413-b35e50caf14c

	measure 'Marge brute' = [CA] - [Coût des ventes]
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 1. Ventes et rentabilité
		lineageTag: e990edc7-02cb-4e66-ba19-24c91b9536c2

	measure 'Taux de marge' = DIVIDE ( [Marge brute], [CA] )
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 35c8cef7-d608-4301-b75b-d0d650d7cbab

	measure 'Unités vendues' = SUM ( Ventes[Unités] )
		formatString: #,0
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 542e1d33-1bfe-4d68-8412-7c849bdd368e

	measure 'Nb ventes' = COUNTROWS ( Ventes )
		formatString: #,0
		displayFolder: 1. Ventes et rentabilité
		lineageTag: d3cb773d-67f6-49bc-8691-002b573cc751

	measure 'CA moyen par vente' = DIVIDE ( [CA], [Nb ventes] )
		formatString: #,0.00 \$;-#,0.00 \$;0.00 \$
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 89eee4d0-81f7-4826-a30f-c5a5dd59df52

	measure 'Nb magasins actifs' = DISTINCTCOUNT ( Ventes[ID magasin] )
		formatString: #,0
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 519f990f-0e18-4ddc-866f-d763df64d24a

	measure 'CA moyen par magasin' = DIVIDE ( [CA], [Nb magasins actifs] )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 54f55d08-74ca-4d73-8a13-194e1bdcc6de

	measure 'CA moyen par jour' = AVERAGEX ( VALUES ( Calendrier[Date] ), [CA] )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 1. Ventes et rentabilité
		lineageTag: 5f178cd6-1896-46a2-99b8-6ba3436371bc

	measure 'CA N-1' =
			IF (
			    HASONEVALUE ( Calendrier[Année] ),
			    CALCULATE ( [CA], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
			)
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 2. Comparaison N-1
		lineageTag: 0a571f63-fd91-4844-81ee-8f36caae355d

	measure 'Évol. CA %' =
			VAR _CAN1 = [CA N-1]
			RETURN
			    IF ( NOT ISBLANK ( _CAN1 ), DIVIDE ( [CA] - _CAN1, _CAN1 ) )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 2. Comparaison N-1
		lineageTag: a9e1a369-d013-4ca7-bf8b-e4cac656c950

	measure 'Évol. CA % (hors lancements)' =
			VAR _CAN1 = [CA N-1]
			RETURN
			    IF ( NOT ISBLANK ( _CAN1 ) && _CAN1 >= 0.25 * [CA], [Évol. CA %] )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 2. Comparaison N-1
		lineageTag: 2eb4dce1-997c-4641-be9d-19f6a8cd3498

	measure 'Marge brute N-1' =
			IF (
			    HASONEVALUE ( Calendrier[Année] ),
			    CALCULATE ( [Marge brute], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
			)
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 2. Comparaison N-1
		lineageTag: 3d2b84af-e1c4-4ce5-b955-3de761ef70b5

	measure 'Évol. marge brute %' =
			VAR _MargeN1 = [Marge brute N-1]
			RETURN
			    IF ( NOT ISBLANK ( _MargeN1 ), DIVIDE ( [Marge brute] - _MargeN1, _MargeN1 ) )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 2. Comparaison N-1
		lineageTag: dcb306c6-06ab-4363-a3d7-3ae38f91485a

	measure 'Écart marge brute vs N-1' =
			VAR _PeriodeN1Disponible =
			    HASONEVALUE ( Calendrier[Année] )
			        && NOT ISEMPTY (
			            CALCULATETABLE (
			                Ventes,
			                SAMEPERIODLASTYEAR ( Calendrier[Date] ),
			                REMOVEFILTERS ( Produits ),
			                REMOVEFILTERS ( Magasins )
			            )
			        )
			RETURN
			    IF ( _PeriodeN1Disponible, [Marge brute] - [Marge brute N-1] )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 2. Comparaison N-1
		lineageTag: 670a3abd-b57b-4f70-8226-1572b27db988

	measure 'Taux de marge N-1' =
			IF (
			    HASONEVALUE ( Calendrier[Année] ),
			    CALCULATE ( [Taux de marge], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
			)
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: 2. Comparaison N-1
		lineageTag: b1736102-a5b5-416d-af70-a0e5e640cb82

	measure 'Écart taux de marge (pts)' =
			VAR _TauxN1 = [Taux de marge N-1]
			RETURN
			    IF ( NOT ISBLANK ( _TauxN1 ), ( [Taux de marge] - _TauxN1 ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 2. Comparaison N-1
		lineageTag: 5dcff5e9-a7a5-4a3a-8492-4acdc5f27645

	measure 'Unités vendues N-1' =
			IF (
			    HASONEVALUE ( Calendrier[Année] ),
			    CALCULATE ( [Unités vendues], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
			)
		formatString: #,0
		displayFolder: 2. Comparaison N-1
		lineageTag: a89950e6-a653-4693-9071-db75208a94d1

	measure 'Évol. unités %' =
			VAR _UnitesN1 = [Unités vendues N-1]
			RETURN
			    IF ( NOT ISBLANK ( _UnitesN1 ), DIVIDE ( [Unités vendues] - _UnitesN1, _UnitesN1 ) )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 2. Comparaison N-1
		lineageTag: e4ab18cb-aba5-4f78-8abc-2280e8002fc2

	measure 'Libellé évol. CA' =
			VAR _Evol = [Évol. CA %]
			RETURN
