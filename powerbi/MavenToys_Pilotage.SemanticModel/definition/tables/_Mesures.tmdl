	measure 'Couleur meilleur emplacement' =
			VAR _Max =
			    MAXX ( ALLSELECTED ( Magasins[Type d'emplacement] ), [CA moyen par magasin] )
			RETURN
			    IF ( [CA moyen par magasin] = _Max, "#2A78D6", "#B7D3F6" )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 2b859324-7f14-4f58-bc5f-fab2dd9a046e

	measure 'Couleur jours les plus forts' =
			IF (
			    RANKX ( ALLSELECTED ( Calendrier[Jour semaine] ), [CA moyen par jour], , DESC ) <= 2,
			    "#2A78D6",
			    "#B7D3F6"
			)
		displayFolder: 3. Libellés et couleurs
		lineageTag: b47e3c1b-a4f9-4b5c-8f45-78785661a5c7

	measure 'Couleur 3 premières villes' =
			IF (
			    RANKX ( ALLSELECTED ( Magasins[Ville] ), [CA], , DESC ) <= 3,
			    "#2A78D6",
			    "#B7D3F6"
			)
		displayFolder: 3. Libellés et couleurs
		lineageTag: ba0e28b5-6c46-40b8-9ef6-cd4be17c231a

	measure Constat =
			SWITCH (
			    SELECTEDVALUE ( Constats[Ordre] ),
			    1, [Constat croissance],
			    2, [Constat taux de marge],
			    3, [Constat meilleure catégorie],
			    4, [Constat pire catégorie],
			    5, [Constat produit à surveiller]
			)
		displayFolder: 3. Libellés et couleurs
		lineageTag: b1a2235c-c725-4660-a45e-164431582149

	measure 'Couleur statut stock' =
			SWITCH (
			    SELECTEDVALUE ( Stock[Statut stock] ),
			    "Rupture", "#B42318",
			    "Critique (< 7 j)", "#B54708",
			    "#52514E"
			)
		displayFolder: 3. Libellés et couleurs
		lineageTag: c2eeaf41-e8f6-42b6-8b02-0455b15d4beb

	measure 'Constat croissance' =
			IF (
			    ISBLANK ( [Évol. CA %] ),
			    "Pas de période N-1 comparable pour cette sélection",
			    "CA " & FORMAT ( [Évol. CA %], "+0.0 %;-0.0 %" )
			        & ", marge brute " & FORMAT ( [Évol. marge brute %], "+0.0 %;-0.0 %" )
			        & ", taux de marge " & FORMAT ( [Écart taux de marge (pts)], "+0.0;-0.0" ) & " pts"
			)
		displayFolder: 3. Libellés et couleurs
		lineageTag: 52da76e2-fef6-4d3a-b534-ab44abefa131

	measure 'Constat taux de marge' =
			VAR _Categories = VALUES ( Produits[Catégorie] )
			VAR _EnRecul = COUNTROWS ( FILTER ( _Categories, [Écart taux de marge (pts)] < 0 ) ) + 0
			RETURN
			    IF (
			        ISBLANK ( [Évol. CA %] ),
			        BLANK (),
			        "En recul dans " & _EnRecul & " catégorie(s) sur " & COUNTROWS ( _Categories )
			    )
		displayFolder: 3. Libellés et couleurs
		lineageTag: d77f562f-aff4-41af-8b92-1cf049df4178

	measure 'Constat meilleure catégorie' =
			VAR _Classement = ADDCOLUMNS ( VALUES ( Produits[Catégorie] ), "@Ecart", [Écart marge brute vs N-1] )
			VAR _Meilleure = TOPN ( 1, _Classement, [@Ecart], DESC )
			VAR _Valeur = MAXX ( _Meilleure, [@Ecart] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Valeur ), BLANK (),
			        _Valeur <= 0, "Aucune catégorie en hausse de marge",
			        MAXX ( _Meilleure, Produits[Catégorie] )
			            & " (" & FORMAT ( _Valeur / 1000, "+#,0;-#,0" ) & " k$)"
			    )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 05c6c094-ac94-4809-999b-181a75767fb4

	measure 'Constat pire catégorie' =
			VAR _Classement = ADDCOLUMNS ( VALUES ( Produits[Catégorie] ), "@Ecart", [Écart marge brute vs N-1] )
			VAR _Pire = TOPN ( 1, _Classement, [@Ecart], ASC )
			VAR _Valeur = MAXX ( _Pire, [@Ecart] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Valeur ), BLANK (),
			        _Valeur >= 0, "Aucune catégorie ne fait reculer la marge",
			        MAXX ( _Pire, Produits[Catégorie] )
			            & " (" & FORMAT ( _Valeur / 1000, "+#,0;-#,0" ) & " k$)"
			    )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 34c7cdf2-f80e-4314-9e89-ff1b2c18211e

	measure 'Constat produit à surveiller' =
			VAR _Classement = ADDCOLUMNS ( VALUES ( Produits[Produit] ), "@Ecart", [Écart marge brute vs N-1] )
			VAR _Pire = TOPN ( 1, _Classement, [@Ecart], ASC )
			VAR _Valeur = MAXX ( _Pire, [@Ecart] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Valeur ), BLANK (),
			        _Valeur >= 0, "Aucun produit en recul de marge",
			        MAXX ( _Pire, Produits[Produit] )
			            & " (" & FORMAT ( _Valeur / 1000, "+#,0;-#,0" ) & " k$ de marge)"
			    )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 398edd52-6748-4d26-b580-649e078093aa

	measure 'Date de référence stock' = CALCULATE ( MAX ( Ventes[Date] ), REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 4. Stock
		lineageTag: 1227d93c-caef-4aee-bc4b-b4416dfcbd12

	measure 'Stock disponible (unités)' = SUM ( Stock[Stock disponible] )
		formatString: #,0
		displayFolder: 4. Stock
		lineageTag: 1322d43f-9b38-4d2c-bebb-401d605f7e64

	measure 'Valeur du stock' = SUMX ( Stock, Stock[Stock disponible] * RELATED ( Produits[Coût unitaire] ) )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 4. Stock
		lineageTag: 9189b23a-fb04-4615-803e-fb9a891c7300

	measure 'Nb références' = COUNTROWS ( Stock )
		formatString: #,0
		displayFolder: 4. Stock
		lineageTag: 14f34d55-7ffc-4ba2-81fc-652ab850be0b

	measure 'Nb ruptures' = CALCULATE ( COUNTROWS ( Stock ), Stock[Statut stock] = "Rupture" ) + 0
		formatString: #,0
		displayFolder: 4. Stock
		lineageTag: ed2bf610-c06e-4dcd-9bcf-d9560867f3ce

	measure 'Nb références critiques' = CALCULATE ( COUNTROWS ( Stock ), Stock[Statut stock] = "Critique (< 7 j)" ) + 0
		formatString: #,0
		displayFolder: 4. Stock
		lineageTag: 9ac47917-07e1-43e1-b04b-30412f0c880d

	measure '% références en rupture' = DIVIDE ( [Nb ruptures], [Nb références] )
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Stock
		lineageTag: a0c2b8b2-fb23-40fd-a6dd-40490833573c

	measure 'Couverture moyenne (jours)' = DIVIDE ( [Stock disponible (unités)], SUM ( Stock[Ventes moy. par jour] ) )
		formatString: #,0.0
		displayFolder: 4. Stock
		lineageTag: ed8f2f51-d87d-4f16-a3ea-d641968b2fd5

	measure 'CA potentiel perdu par jour' =
			SUMX (
			    FILTER ( Stock, Stock[Statut stock] = "Rupture" ),
			    Stock[Ventes moy. par jour] * RELATED ( Produits[Prix unitaire] )
			) + 0
		formatString: #,0.00 \$;-#,0.00 \$;0.00 \$
		displayFolder: 4. Stock
		lineageTag: 1f232a46-b7e3-4bce-a9b2-da304d0a267a

	measure 'CA potentiel perdu sur 30 j' = [CA potentiel perdu par jour] * 30
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 4. Stock
		lineageTag: 845a99c3-a9aa-459c-a7a4-f25deeb78f6d

	measure 'Valeur stock immobilisé' =
			CALCULATE (
			    [Valeur du stock],
			    Stock[Statut stock] IN { "Surstock (> 90 j)", "Stock dormant" }
			) + 0
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 4. Stock
		lineageTag: e988681b-baa5-4044-85f4-2fbd58ce1bda

	measure '% stock immobilisé' = DIVIDE ( [Valeur stock immobilisé], [Valeur du stock] )
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Stock
		lineageTag: 709cfe5d-040e-4591-a6b3-87c62ebc8fba

	measure 'Libellé valeur du stock' =
			FORMAT ( [Stock disponible (unités)], "#,##0" ) & " unités au "
			    & FORMAT ( [Date de référence stock], "dd/mm/yyyy" )
		displayFolder: 4. Stock
		lineageTag: a2fddfaa-5559-4c81-afe8-a31a79324fdd

	measure 'Libellé ruptures' =
			FORMAT ( [% références en rupture], "0.0 %" ) & " des références + "
			    & FORMAT ( [Nb références critiques], "#,##0" ) & " critiques"
		displayFolder: 4. Stock
		lineageTag: e1be1a35-c415-4767-9155-c06f60519dc4

	measure 'Libellé CA perdu' = FORMAT ( [CA potentiel perdu par jour], "#,##0" ) & " $ par jour (estimation)"
		displayFolder: 4. Stock
		lineageTag: 905f7a97-c54c-4cb0-a57a-a1a8939f87e2

	measure 'Libellé stock immobilisé' = FORMAT ( [% stock immobilisé], "0.0 %" ) & " de la valeur du stock"
		displayFolder: 4. Stock
		lineageTag: ab974f9b-078f-4bc4-aba1-27d9eb3aed2f

	measure 'Écart marge brute (10 plus fortes baisses)' =
			VAR _Ecart = [Écart marge brute vs N-1]
			VAR _Rang =
			    RANKX ( ALLSELECTED ( Produits[Produit] ), [Écart marge brute vs N-1], , ASC )
			RETURN
			    IF ( _Ecart < 0 && _Rang <= 10, _Ecart )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 5. Classements
		lineageTag: 43fe9192-961e-4413-8741-4e876b407579

	measure 'CA (10 premières villes)' =
			VAR _Rang =
			    RANKX ( ALLSELECTED ( Magasins[Ville] ), [CA], , DESC )
			RETURN
			    IF ( _Rang <= 10, [CA] )
		formatString: #,0 \$;-#,0 \$;0 \$
		displayFolder: 5. Classements
		lineageTag: 48136121-2deb-4bec-9bd8-17a6d234f391

	measure 'CA perdu par jour (10 premiers produits)' =
			VAR _Perte = [CA potentiel perdu par jour]
			VAR _Rang =
			    RANKX ( ALLSELECTED ( Produits[Produit] ), [CA potentiel perdu par jour], , DESC )
			RETURN
			    IF ( _Perte > 0 && _Rang <= 10, _Perte )
		formatString: #,0.00 \$;-#,0.00 \$;0.00 \$
		displayFolder: 5. Classements
		lineageTag: 7f372189-a836-45ea-afd3-b6f806561dfa

