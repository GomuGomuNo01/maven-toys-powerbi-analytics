	measure 'Titre baisses de marge' = IF ( [Vue par défaut], "Colorbuds concentre l'essentiel de la perte de marge", "Produits dont la marge brute recule le plus" )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 69ac4a72-fbfa-46ad-bd2a-38ade1b5754d

	measure 'Titre emplacements' = IF ( [Vue par défaut], "Un magasin d'aéroport rapporte 1,5 fois plus", "CA moyen par magasin selon l'emplacement" )
		displayFolder: 3. Libellés et couleurs
		lineageTag: 45359134-358e-4890-8d12-0bbc5fff744e

	measure 'Titre jours' = IF ( [Vue par défaut], "Vendredi et samedi : pics d'activité", "CA moyen par jour de la semaine" )
		displayFolder: 3. Libellés et couleurs
