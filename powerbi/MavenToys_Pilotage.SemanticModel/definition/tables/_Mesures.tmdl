	measure 'Titre cascade marge' = IF ( [Vue par défaut], "Électronique : seule catégorie qui fait reculer la marge", "Écart de marge brute vs N-1 par catégorie" )
		displayFolder: 3. Libellés et couleurs
		lineageTag: fab07c47-e1c1-4fd8-9faa-1becde42ea13

	measure 'Titre taux de marge' = IF ( [Vue par défaut], "Le taux de marge recule dans 4 catégories sur 5", "Taux de marge par catégorie : N vs N-1" )
		displayFolder: 3. Libellés et couleurs
