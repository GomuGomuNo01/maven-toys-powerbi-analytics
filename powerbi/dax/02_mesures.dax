// =============================================================================
// MESURES DAX : à exécuter dans la VUE REQUÊTE DAX de Power BI Desktop
// =============================================================================
// Mode opératoire :
//   1. Barre latérale gauche > icône "Vue Requête DAX"
//   2. Coller l'intégralité de ce fichier
//   3. Cliquer sur "Exécuter" : les tableaux de contrôle en bas du script s'affichent
//   4. Cliquer sur "Mettre à jour le modèle avec les modifications" : toutes les
//      mesures définies ci-dessous sont ajoutées au modèle en une seule fois
//
// Prérequis : tables Ventes, Produits, Magasins, Stock, Calendrier et _Mesures
// chargées, relations créées, Calendrier marqué comme table de dates, colonnes
// calculées de Stock créées (fichier 01_colonnes_calculees_stock.dax).
//
// Règle de lecture : "N-1" = même période l'année précédente. Les données 2023
// s'arrêtent au 30/09 : janv.-sept. 2023 est donc comparé à janv.-sept. 2022.
// =============================================================================

DEFINE

    // -------------------------------------------------------------------------
    // 1. VENTES ET RENTABILITÉ
    // -------------------------------------------------------------------------

    // Chiffre d'affaires : unités x prix unitaire, calculé ligne à ligne (SUMX)
    // car le prix est dans Produits et les unités dans Ventes
    MEASURE '_Mesures'[CA] =
        SUMX ( Ventes, Ventes[Unités] * RELATED ( Produits[Prix unitaire] ) )

    MEASURE '_Mesures'[Coût des ventes] =
        SUMX ( Ventes, Ventes[Unités] * RELATED ( Produits[Coût unitaire] ) )

    MEASURE '_Mesures'[Marge brute] =
        [CA] - [Coût des ventes]

    // DIVIDE évite l'erreur de division par zéro (renvoie vide)
    MEASURE '_Mesures'[Taux de marge] =
        DIVIDE ( [Marge brute], [CA] )

    MEASURE '_Mesures'[Unités vendues] =
        SUM ( Ventes[Unités] )

    // Une ligne de la table Ventes = une vente d'un produit
    MEASURE '_Mesures'[Nb ventes] =
        COUNTROWS ( Ventes )

    MEASURE '_Mesures'[CA moyen par vente] =
        DIVIDE ( [CA], [Nb ventes] )

    MEASURE '_Mesures'[Nb magasins actifs] =
        DISTINCTCOUNT ( Ventes[ID magasin] )

    // Permet de comparer des groupes de tailles différentes (29 magasins en
    // centre-ville contre 3 en aéroport)
    MEASURE '_Mesures'[CA moyen par magasin] =
        DIVIDE ( [CA], [Nb magasins actifs] )

    // Moyenne du CA quotidien sur les jours du contexte (ex. tous les vendredis)
    MEASURE '_Mesures'[CA moyen par jour] =
        AVERAGEX ( VALUES ( Calendrier[Date] ), [CA] )

    // -------------------------------------------------------------------------
    // 2. COMPARAISON À PÉRIODE ÉGALE (N-1)
    // -------------------------------------------------------------------------
    // HASONEVALUE : la comparaison n'a de sens que si une seule année est
    // sélectionnée. Sans ce garde-fou, "toutes années" comparerait 21 mois à 9 mois.

    MEASURE '_Mesures'[CA N-1] =
        IF (
            HASONEVALUE ( Calendrier[Année] ),
            CALCULATE ( [CA], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
        )

    MEASURE '_Mesures'[Évol. CA %] =
        VAR _CAN1 = [CA N-1]
        RETURN
            IF ( NOT ISBLANK ( _CAN1 ), DIVIDE ( [CA] - _CAN1, _CAN1 ) )

    // Évolution affichée dans les tableaux : masquée quand la base N-1 est inférieure
    // à 25 % du CA (produits lancés en 2022). Un "+24 825 %" n'aide pas à décider.
    MEASURE '_Mesures'[Évol. CA % (hors lancements)] =
        VAR _CAN1 = [CA N-1]
        RETURN
            IF ( NOT ISBLANK ( _CAN1 ) && _CAN1 >= 0.25 * [CA], [Évol. CA %] )

    MEASURE '_Mesures'[Marge brute N-1] =
        IF (
            HASONEVALUE ( Calendrier[Année] ),
            CALCULATE ( [Marge brute], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
        )

    MEASURE '_Mesures'[Évol. marge brute %] =
        VAR _MargeN1 = [Marge brute N-1]
        RETURN
            IF ( NOT ISBLANK ( _MargeN1 ), DIVIDE ( [Marge brute] - _MargeN1, _MargeN1 ) )

    // Écart en valeur, utilisé dans le graphique en cascade.
    // On vérifie que la période N-1 existe pour l'entreprise (tous produits et
    // magasins confondus) : un produit lancé en 2023 contribue alors pour toute
    // sa marge, au lieu d'afficher un vide.
    MEASURE '_Mesures'[Écart marge brute vs N-1] =
        VAR _PeriodeN1Disponible =
            HASONEVALUE ( Calendrier[Année] )
                && NOT ISEMPTY (
                    CALCULATETABLE (
                        Ventes,
                        SAMEPERIODLASTYEAR ( Calendrier[Date] ),
                        REMOVEFILTERS ( Produits ),
                        REMOVEFILTERS ( Magasins )
                    )
                )
        RETURN
            IF ( _PeriodeN1Disponible, [Marge brute] - [Marge brute N-1] )

    MEASURE '_Mesures'[Taux de marge N-1] =
        IF (
            HASONEVALUE ( Calendrier[Année] ),
            CALCULATE ( [Taux de marge], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
        )

    // Écart exprimé en points de pourcentage (26,2 % - 29,5 % = -3,3 pts)
    MEASURE '_Mesures'[Écart taux de marge (pts)] =
        VAR _TauxN1 = [Taux de marge N-1]
        RETURN
            IF ( NOT ISBLANK ( _TauxN1 ), ( [Taux de marge] - _TauxN1 ) * 100 )

    MEASURE '_Mesures'[Unités vendues N-1] =
        IF (
            HASONEVALUE ( Calendrier[Année] ),
            CALCULATE ( [Unités vendues], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
        )

    MEASURE '_Mesures'[Évol. unités %] =
        VAR _UnitesN1 = [Unités vendues N-1]
        RETURN
            IF ( NOT ISBLANK ( _UnitesN1 ), DIVIDE ( [Unités vendues] - _UnitesN1, _UnitesN1 ) )

    // -------------------------------------------------------------------------
    // 3. LIBELLÉS ET MISE EN FORME (cartes KPI, sous-titres, couleurs)
    // -------------------------------------------------------------------------

    MEASURE '_Mesures'[Libellé évol. CA] =
        VAR _Evol = [Évol. CA %]
        RETURN
            IF (
                ISBLANK ( _Evol ),
                "Pas de période N-1 comparable",
                FORMAT ( _Evol, "+0.0 %;-0.0 %" ) & " vs N-1"
            )

    MEASURE '_Mesures'[Libellé évol. marge brute] =
        VAR _Evol = [Évol. marge brute %]
        RETURN
            IF (
                ISBLANK ( _Evol ),
                "Pas de période N-1 comparable",
                FORMAT ( _Evol, "+0.0 %;-0.0 %" ) & " vs N-1"
            )

    MEASURE '_Mesures'[Libellé écart taux de marge] =
        VAR _Ecart = [Écart taux de marge (pts)]
        RETURN
            IF (
                ISBLANK ( _Ecart ),
                "Pas de période N-1 comparable",
                FORMAT ( _Ecart, "+0.0;-0.0" ) & " pts vs N-1"
            )

    MEASURE '_Mesures'[Libellé évol. unités] =
        VAR _Evol = [Évol. unités %]
        RETURN
            IF (
                ISBLANK ( _Evol ),
                "Pas de période N-1 comparable",
                FORMAT ( _Evol, "+0.0 %;-0.0 %" ) & " vs N-1"
            )

    // Couleur utilisée en mise en forme conditionnelle ("Valeur du champ")
    MEASURE '_Mesures'[Couleur évol. CA] =
        SWITCH (
            TRUE (),
            ISBLANK ( [Évol. CA %] ), "#898781",
            [Évol. CA %] < 0, "#D03B3B",
            "#006300"
        )

    MEASURE '_Mesures'[Couleur écart marge] =
        SWITCH (
            TRUE (),
            ISBLANK ( [Écart marge brute vs N-1] ), "#898781",
            [Écart marge brute vs N-1] < 0, "#D03B3B",
            "#006300"
        )

    // Couleurs des libellés d'évolution sous les cartes KPI (vert = hausse, rouge = baisse)
    MEASURE '_Mesures'[Couleur évol. marge brute] =
        SWITCH (
            TRUE (),
            ISBLANK ( [Évol. marge brute %] ), "#898781",
            [Évol. marge brute %] < 0, "#D03B3B",
            "#006300"
        )

    MEASURE '_Mesures'[Couleur écart taux de marge] =
        SWITCH (
            TRUE (),
            ISBLANK ( [Écart taux de marge (pts)] ), "#898781",
            [Écart taux de marge (pts)] < 0, "#D03B3B",
            "#006300"
        )

    MEASURE '_Mesures'[Couleur évol. unités] =
        SWITCH (
            TRUE (),
            ISBLANK ( [Évol. unités %] ), "#898781",
            [Évol. unités %] < 0, "#D03B3B",
            "#006300"
        )

    // Titres dynamiques : le message clé ne s'affiche que dans la vue analysée
    // (2023, sans filtre catégorie ni emplacement). Dès qu'un filtre change le
    // contexte, un titre neutre le remplace pour ne jamais afficher une affirmation fausse.
    MEASURE '_Mesures'[Vue par défaut] =
        SELECTEDVALUE ( Calendrier[Année] ) = 2023
            && NOT ISFILTERED ( Produits[Catégorie] )
            && NOT ISFILTERED ( Magasins[Type d'emplacement] )

    MEASURE '_Mesures'[Vue par défaut stock] =
        NOT ISFILTERED ( Produits[Catégorie] )
            && NOT ISFILTERED ( Magasins[Type d'emplacement] )
            && NOT ISFILTERED ( Stock[Statut stock] )

    MEASURE '_Mesures'[Titre CA mensuel] =
        IF ( [Vue par défaut], "Le CA dépasse l'année précédente chaque mois", "CA mensuel : N vs N-1" )

    MEASURE '_Mesures'[Titre cascade marge] =
        IF ( [Vue par défaut], "Électronique : seule catégorie qui fait reculer la marge", "Écart de marge brute vs N-1 par catégorie" )

    MEASURE '_Mesures'[Titre taux de marge] =
        IF ( [Vue par défaut], "Le taux de marge recule dans 4 catégories sur 5", "Taux de marge par catégorie : N vs N-1" )

    MEASURE '_Mesures'[Titre baisses de marge] =
        IF ( [Vue par défaut], "Colorbuds concentre l'essentiel de la perte de marge", "Produits dont la marge brute recule le plus" )

    MEASURE '_Mesures'[Titre emplacements] =
        IF ( [Vue par défaut], "Un magasin d'aéroport rapporte 1,5 fois plus", "CA moyen par magasin selon l'emplacement" )

    MEASURE '_Mesures'[Titre jours] =
        IF ( [Vue par défaut], "Vendredi et samedi : pics d'activité", "CA moyen par jour de la semaine" )

    MEASURE '_Mesures'[Titre statuts stock] =
        IF ( [Vue par défaut stock], "Jouets et Arts créatifs concentrent les ruptures", "Répartition des références par statut" )

    // Mise en évidence calculée : la couleur suit les données filtrées, pas un nom figé
    MEASURE '_Mesures'[Couleur meilleur emplacement] =
        VAR _Max =
            MAXX ( ALLSELECTED ( Magasins[Type d'emplacement] ), [CA moyen par magasin] )
        RETURN
            IF ( [CA moyen par magasin] = _Max, "#2A78D6", "#B7D3F6" )

    MEASURE '_Mesures'[Couleur jours les plus forts] =
        IF (
            RANKX ( ALLSELECTED ( Calendrier[Jour semaine] ), [CA moyen par jour], , DESC ) <= 2,
            "#2A78D6",
            "#B7D3F6"
        )

    MEASURE '_Mesures'[Couleur 3 premières villes] =
        IF (
            RANKX ( ALLSELECTED ( Magasins[Ville] ), [CA], , DESC ) <= 3,
            "#2A78D6",
            "#B7D3F6"
        )

    // Constat de la ligne en cours dans le tableau « À retenir »
    MEASURE '_Mesures'[Constat] =
        SWITCH (
            SELECTEDVALUE ( Constats[Ordre] ),
            1, [Constat croissance],
            2, [Constat taux de marge],
            3, [Constat meilleure catégorie],
            4, [Constat pire catégorie],
            5, [Constat produit à surveiller]
        )

    // Couleur du texte de statut dans la liste des références à traiter
    MEASURE '_Mesures'[Couleur statut stock] =
        SWITCH (
            SELECTEDVALUE ( Stock[Statut stock] ),
            "Rupture", "#B42318",
            "Critique (< 7 j)", "#B54708",
            "#52514E"
        )

    // Constats dynamiques du bloc « À retenir » : phrases calculées à partir des
    // mesures, donc toujours justes quelle que soit la sélection (année, catégorie, emplacement).
    // Affichées dans un tableau : une ligne par thème de la table Constats (03_table_constats.dax).
    MEASURE '_Mesures'[Constat croissance] =
        IF (
            ISBLANK ( [Évol. CA %] ),
            "Pas de période N-1 comparable pour cette sélection",
            "CA " & FORMAT ( [Évol. CA %], "+0.0 %;-0.0 %" )
                & ", marge brute " & FORMAT ( [Évol. marge brute %], "+0.0 %;-0.0 %" )
                & ", taux de marge " & FORMAT ( [Écart taux de marge (pts)], "+0.0;-0.0" ) & " pts"
        )

    MEASURE '_Mesures'[Constat taux de marge] =
        VAR _Categories = VALUES ( Produits[Catégorie] )
        VAR _EnRecul = COUNTROWS ( FILTER ( _Categories, [Écart taux de marge (pts)] < 0 ) ) + 0
        RETURN
            IF (
                ISBLANK ( [Évol. CA %] ),
                BLANK (),
                "En recul dans " & _EnRecul & " catégorie(s) sur " & COUNTROWS ( _Categories )
            )

    MEASURE '_Mesures'[Constat meilleure catégorie] =
        VAR _Classement = ADDCOLUMNS ( VALUES ( Produits[Catégorie] ), "@Ecart", [Écart marge brute vs N-1] )
        VAR _Meilleure = TOPN ( 1, _Classement, [@Ecart], DESC )
        VAR _Valeur = MAXX ( _Meilleure, [@Ecart] )
        RETURN
            IF (
                ISBLANK ( _Valeur ),
                BLANK (),
                MAXX ( _Meilleure, Produits[Catégorie] )
                    & " (" & FORMAT ( _Valeur / 1000, "+#,0;-#,0" ) & " k$)"
            )

    MEASURE '_Mesures'[Constat pire catégorie] =
        VAR _Classement = ADDCOLUMNS ( VALUES ( Produits[Catégorie] ), "@Ecart", [Écart marge brute vs N-1] )
        VAR _Pire = TOPN ( 1, _Classement, [@Ecart], ASC )
        VAR _Valeur = MAXX ( _Pire, [@Ecart] )
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _Valeur ), BLANK (),
                _Valeur >= 0, "Aucune catégorie ne fait reculer la marge",
                MAXX ( _Pire, Produits[Catégorie] )
                    & " (" & FORMAT ( _Valeur / 1000, "+#,0;-#,0" ) & " k$)"
            )

    MEASURE '_Mesures'[Constat produit à surveiller] =
        VAR _Classement = ADDCOLUMNS ( VALUES ( Produits[Produit] ), "@Ecart", [Écart marge brute vs N-1] )
        VAR _Pire = TOPN ( 1, _Classement, [@Ecart], ASC )
        VAR _Valeur = MAXX ( _Pire, [@Ecart] )
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _Valeur ), BLANK (),
                _Valeur >= 0, "Aucun produit en recul de marge",
                MAXX ( _Pire, Produits[Produit] )
                    & " (" & FORMAT ( _Valeur / 1000, "+#,0;-#,0" ) & " k$ de marge)"
            )

    // -------------------------------------------------------------------------
    // 4. STOCK ET RISQUE DE RUPTURE (photo au 30/09/2023)
    // -------------------------------------------------------------------------
    // La table Stock n'est pas reliée au calendrier : ces mesures ignorent les
    // filtres de date. Elles réagissent aux filtres Produits et Magasins.

    MEASURE '_Mesures'[Date de référence stock] =
        CALCULATE ( MAX ( Ventes[Date] ), REMOVEFILTERS () )

    MEASURE '_Mesures'[Stock disponible (unités)] =
        SUM ( Stock[Stock disponible] )

    // Valorisation au coût d'achat : c'est l'argent immobilisé en stock
    MEASURE '_Mesures'[Valeur du stock] =
        SUMX ( Stock, Stock[Stock disponible] * RELATED ( Produits[Coût unitaire] ) )

    MEASURE '_Mesures'[Nb références] =
        COUNTROWS ( Stock )

    MEASURE '_Mesures'[Nb ruptures] =
        CALCULATE ( COUNTROWS ( Stock ), Stock[Statut stock] = "Rupture" ) + 0

    MEASURE '_Mesures'[Nb références critiques] =
        CALCULATE ( COUNTROWS ( Stock ), Stock[Statut stock] = "Critique (< 7 j)" ) + 0

    MEASURE '_Mesures'[% références en rupture] =
        DIVIDE ( [Nb ruptures], [Nb références] )

    // Couverture agrégée : stock total / demande journalière totale du périmètre
    MEASURE '_Mesures'[Couverture moyenne (jours)] =
        DIVIDE ( [Stock disponible (unités)], SUM ( Stock[Ventes moy. par jour] ) )

    // Estimation : ce que les références en rupture auraient vendu chaque jour
    // si elles avaient été disponibles, au rythme des 90 derniers jours
    MEASURE '_Mesures'[CA potentiel perdu par jour] =
        SUMX (
            FILTER ( Stock, Stock[Statut stock] = "Rupture" ),
            Stock[Ventes moy. par jour] * RELATED ( Produits[Prix unitaire] )
        ) + 0

    MEASURE '_Mesures'[CA potentiel perdu sur 30 j] =
        [CA potentiel perdu par jour] * 30

    // Capital immobilisé dans des produits qui tournent trop lentement
    MEASURE '_Mesures'[Valeur stock immobilisé] =
        CALCULATE (
            [Valeur du stock],
            Stock[Statut stock] IN { "Surstock (> 90 j)", "Stock dormant" }
        ) + 0

    MEASURE '_Mesures'[% stock immobilisé] =
        DIVIDE ( [Valeur stock immobilisé], [Valeur du stock] )

    MEASURE '_Mesures'[Libellé valeur du stock] =
        FORMAT ( [Stock disponible (unités)], "#,##0" ) & " unités au "
            & FORMAT ( [Date de référence stock], "dd/mm/yyyy" )

    MEASURE '_Mesures'[Libellé ruptures] =
        FORMAT ( [% références en rupture], "0.0 %" ) & " des références + "
            & FORMAT ( [Nb références critiques], "#,##0" ) & " critiques"

    MEASURE '_Mesures'[Libellé CA perdu] =
        FORMAT ( [CA potentiel perdu par jour], "#,##0" ) & " $ par jour (estimation)"

    MEASURE '_Mesures'[Libellé stock immobilisé] =
        FORMAT ( [% stock immobilisé], "0.0 %" ) & " de la valeur du stock"

    // -------------------------------------------------------------------------
    // 5. CLASSEMENTS (TOP 10)
    // -------------------------------------------------------------------------
    // Alternative au filtre "N premiers" : la mesure renvoie un vide hors du
    // top 10, et le visuel masque automatiquement les lignes vides.
    // ALLSELECTED respecte les segments de la page (ex. une catégorie).

    MEASURE '_Mesures'[Écart marge brute (10 plus fortes baisses)] =
        VAR _Ecart = [Écart marge brute vs N-1]
        VAR _Rang =
            RANKX ( ALLSELECTED ( Produits[Produit] ), [Écart marge brute vs N-1], , ASC )
        RETURN
            IF ( _Ecart < 0 && _Rang <= 10, _Ecart )

    MEASURE '_Mesures'[CA (10 premières villes)] =
        VAR _Rang =
            RANKX ( ALLSELECTED ( Magasins[Ville] ), [CA], , DESC )
        RETURN
            IF ( _Rang <= 10, [CA] )

    MEASURE '_Mesures'[CA perdu par jour (10 premiers produits)] =
        VAR _Perte = [CA potentiel perdu par jour]
        VAR _Rang =
            RANKX ( ALLSELECTED ( Produits[Produit] ), [CA potentiel perdu par jour], , DESC )
        RETURN
            IF ( _Perte > 0 && _Rang <= 10, _Perte )


// =============================================================================
// CONTRÔLES : comparer ces résultats aux valeurs de analysis/audit_donnees.py
// =============================================================================

// Contrôle 1 : indicateurs globaux par année
// Attendu 2023 : CA 6 962 074,27 | CA N-1 5 320 115,85 | Évol. +30,9 % | Écart taux -3,3 pts
EVALUATE
SUMMARIZECOLUMNS (
    Calendrier[Année],
    "CA", [CA],
    "CA N-1", [CA N-1],
    "Évol. CA %", [Évol. CA %],
    "Marge brute", [Marge brute],
    "Évol. marge brute %", [Évol. marge brute %],
    "Taux de marge", [Taux de marge],
    "Écart taux de marge (pts)", [Écart taux de marge (pts)],
    "Unités vendues", [Unités vendues]
)

// Contrôle 2 : contribution des catégories à l'écart de marge en 2023
// Attendu : Électronique -210 260 | Arts créatifs +335 745
EVALUATE
SUMMARIZECOLUMNS (
    Produits[Catégorie],
    TREATAS ( { 2023 }, Calendrier[Année] ),
    "CA", [CA],
    "Évol. CA %", [Évol. CA %],
    "Écart marge brute vs N-1", [Écart marge brute vs N-1],
    "Taux de marge", [Taux de marge]
)

// Contrôle 3 : répartition des statuts de stock
// Attendu : Rupture 77 | Critique 289 | Normal 1 018 | Surstock 116 | Dormant 93
EVALUATE
SUMMARIZECOLUMNS (
    Stock[Statut stock],
    "Nb références", [Nb références],
    "Valeur du stock", [Valeur du stock],
    "CA potentiel perdu par jour", [CA potentiel perdu par jour]
)
